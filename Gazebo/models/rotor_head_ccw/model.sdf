<?xml version="1.0"?>
<!--
See rotor_head_cw for details.

This model is a copy of rotor_head_cw to work around current
limitations in the DetachableJoint plugin.
-->
<sdf version="1.11">
  <model name="rotor_head_ccw">
    <link name="base_link">
      <pose degrees="true">0 0 -0.2 0 0 -13</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>4.16667E-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.16667E-05</iyy>
          <iyz>0</iyz>
          <izz>4.16667E-05</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2</ambient>
          <diffuse>0.2 0.2 0.2</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      
    </link>
    <joint name="main_joint" type="revolute">
      <pose degrees="true">0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>main_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.0e16</lower>
          <upper>1.0e16</upper>
          <!-- fix blade for setting H_CYC_MAX
          <lower>1.3439035240356338</lower>
          <upper>1.3439035240356338</upper>
          -->
        </limit>
        <dynamics>
          <damping>0.001</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
      <!-- Disabled - impacts performance at high rate needed for analysis -->
      <!-- <sensor name="force_torque" type="force_torque">
        <update_rate>1000</update_rate>
        <frame>parent</frame>
      </sensor> -->
    </joint>

