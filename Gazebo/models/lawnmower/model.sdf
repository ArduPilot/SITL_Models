      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <pose degrees="true">0 0 0 180 0 0</pose>
        <update_rate>1000</update_rate>
      </sensor>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <pose relative_to="base_link">-0.45 0.45 0.0215 0 0 0</pose>
      <parent>base_link</parent>
      <child>left_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.02</damping>
        </dynamics>
      </axis>
    </joint>
    <link name="left_wheel_link">
      <pose relative_to="left_wheel_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 1.57079632679 0 0</pose>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.115</ixx>
          <ixy>0.0</ixy>
          <iyy>0.115</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>0.194</izz>
        </inertia>
      </inertial>
      <collision name="left_wheel_link_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.22</length>
          </cylinder>
        </geometry>
        <max_contacts>1</max_contacts>
        <surface>
          <friction>
            <torsional>
              <coefficient>0.25</coefficient>
              <use_patch_radius>1</use_patch_radius>
              <surface_radius>0.22</surface_radius>
            </torsional>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>1e6</threshold>
          </bounce>
          <contact>
            <ode>
              <min_depth>0.005</min_depth>
              <kp>1e8</kp>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="left_wheel_link_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.22</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>
    <joint name="right_wheel_joint" type="revolute">
