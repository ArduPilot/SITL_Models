          <cylinder>
            <radius>0.22</radius>
            <length>0.22</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>

    <joint name="engine_visual_joint" type="fixed">
      <pose relative_to="base_link">-0.9 0 0.5 0 0 0</pose>
      <parent>base_link</parent>
      <child>engine_visual_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>
    <link name="engine_visual_link">
      <pose relative_to="engine_visual_joint">0 0 0 0 0 0</pose>
