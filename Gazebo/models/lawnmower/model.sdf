          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <visual name="left_caster_visual">
        <pose>0.85 0.38 -0.1 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>.1</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
