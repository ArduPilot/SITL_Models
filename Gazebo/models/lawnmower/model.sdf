          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.02</damping>
        </dynamics>
      </axis>
    </joint>
    <link name="right_wheel_link">
      <pose relative_to="right_wheel_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 1.57079632679 0 0</pose>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.115</ixx>
          <ixy>0.0</ixy>
          <iyy>0.115</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>0.194</izz>
        </inertia>
      </inertial>
      <collision name="right_wheel_link_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.22</length>
          </cylinder>
        </geometry>
        <max_contacts>1</max_contacts>
        <surface>
          <friction>
            <torsional>
              <coefficient>0.25</coefficient>
              <use_patch_radius>1</use_patch_radius>
              <surface_radius>0.22</surface_radius>
            </torsional>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
